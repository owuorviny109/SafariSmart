# =============================================================================
# SAFARISMART KENYA - SECURITY CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# CRITICAL SECURITY SETTINGS
# =============================================================================

# Django Secret Key (REQUIRED)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here-minimum-50-characters-long

# Debug Mode (MUST be False in production)
DEBUG=False

# Allowed Hosts (comma-separated, no spaces)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# =============================================================================
# HTTPS/SSL SETTINGS
# =============================================================================

# Enable HTTPS redirect (True in production)
SECURE_SSL_REDIRECT=True

# HSTS Settings
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Secure Cookies (True in production)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# =============================================================================
# SESSION SECURITY
# =============================================================================

# Session timeout (seconds) - 3600 = 1 hour
SESSION_COOKIE_AGE=3600

# Expire session when browser closes
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# =============================================================================
# PASSWORD SECURITY
# =============================================================================

# Minimum password length
PASSWORD_MIN_LENGTH=12

# =============================================================================
# BRUTE FORCE PROTECTION (Django-Axes)
# =============================================================================

# Enable brute force protection
AXES_ENABLED=True

# Lock out after N failed attempts
AXES_FAILURE_LIMIT=5

# Lock out duration (hours) - 0.5 = 30 minutes
AXES_COOLOFF_TIME=0.5

# =============================================================================
# RATE LIMITING
# =============================================================================

# Enable rate limiting
RATELIMIT_ENABLE=True

# Global rate limit (requests per minute per IP)
GLOBAL_RATE_LIMIT_PER_MINUTE=100

# API rate limits
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=1000
API_RATE_LIMIT_PER_DAY=10000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL (Production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=safarismart_db
DB_USER=safarismart_user
DB_PASSWORD=your-strong-database-password
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# API KEYS
# =============================================================================

# Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key-here

# OpenWeatherMap API Key
OPENWEATHER_API_KEY=your-openweather-api-key-here

# =============================================================================
# ADMIN SECURITY
# =============================================================================

# Custom admin URL (change from default 'admin/')
ADMIN_URL=secure-admin-panel/

# Admin IP whitelist (comma-separated, leave empty to allow all)
ADMIN_ALLOWED_IPS=

# =============================================================================
# CORS SETTINGS (if API is public)
# =============================================================================

# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Email backend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Default from email
DEFAULT_FROM_EMAIL=noreply@safarismart.co.ke
SERVER_EMAIL=server@safarismart.co.ke

# Admin email for error notifications
ADMIN_EMAIL=admin@safarismart.co.ke

# =============================================================================
# LOGGING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=WARNING

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================

# Backup encryption key
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# =============================================================================
# MONITORING & ALERTS
# =============================================================================

# Sentry DSN (for error tracking)
SENTRY_DSN=

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================

# Before deploying to production, ensure:
# 1. SECRET_KEY is strong and unique
# 2. DEBUG=False
# 3. ALLOWED_HOSTS is set correctly
# 4. SECURE_SSL_REDIRECT=True
# 5. SESSION_COOKIE_SECURE=True
# 6. CSRF_COOKIE_SECURE=True
# 7. Database is PostgreSQL (not SQLite)
# 8. All API keys are set
# 9. Email is configured
# 10. Backups are automated
# 11. Monitoring is set up
# 12. SSL certificate is installed
# 13. Firewall is configured
# 14. Server is hardened
# 15. Security audit completed

# =============================================================================
# DEVELOPMENT SETTINGS (Override for local development)
# =============================================================================

# For local development, you can use:
# DEBUG=True
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# ALLOWED_HOSTS=localhost,127.0.0.1
